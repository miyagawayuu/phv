<?phv
import std.http.{request, response, session};
import lib.client.client_key;
import lib.source.sources;
import lib.store.{demo_db, recent_messages, add_message, validate_message};

$req = request();
$db = demo_db();
$name = session()->get("name") ?? "";
$text = "";
list<string> $errors = [];

// The server has already checked the CSRF token before this line runs:
// a POST without a valid csrf_field() never gets here.
if ($req->isPost()) {
    $name = ($req->form("name") ?? "")->trim();
    $text = ($req->form("text") ?? "")->trim();
    $errors = validate_message($name, $text);
    $ip = client_key();
    if ($errors->isEmpty() && (!rate_limit("board:" . $ip, 3, 60) || !rate_limit("board:" . $ip, 20, 86400))) {
        $errors[] = "Too many messages from your address; please wait a little.";
    }
    if ($errors->isEmpty()) {
        add_message($db, $name, $text);
        session()->set("name", $name);
        session()->set("notice", "Posted. It stays up for 24 hours.");
        response()->redirect("/board");   // post/redirect/get
        return;
    }
}

$body = render(
    "views/board.phv.html",
    messages: recent_messages($db),
    name: $name,
    text: $text,
    errors: $errors,
    notice: session()->flash("notice"),
);
echo render(
    "views/layout.phv.html",
    title: "Message board",
    path: "/board",
    body: $body,
    files: sources(["public/board.phv", "lib/store.phv", "views/board.phv.html"]),
);
