<?phx
import std.http.request;
import lib.source.sources;

$req = request();
$input = $req->query("input") ?? "<script>alert(\"hi\")</script> & 'quotes'";
$url = $req->query("url") ?? "javascript:alert(document.cookie)";
if ($input->len() > 200) {
    $input = $input->slice(0, 200);
}

$body = render("views/escape.phx.html", input: $input, url: $url);
echo render(
    "views/layout.phx.html",
    title: "Escaping",
    path: "/escape",
    body: $body,
    files: sources(["public/escape.phx", "views/escape.phx.html"]),
);
