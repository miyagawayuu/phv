<?phv
import std.http.request;
import lib.source.sources;

$name = (request()->query("name") ?? "")->trim();
if ($name->isEmpty() || $name->len() > 40) {
    $name = "world";
}

$body = render("views/home.phv.html", name: $name);
echo render(
    "views/layout.phv.html",
    title: "Live demo",
    path: "/",
    body: $body,
    files: sources(["public/index.phv", "views/home.phv.html"]),
);
