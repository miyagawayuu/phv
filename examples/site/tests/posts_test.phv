<?phv
import lib.posts.{Post, all_posts, find_post};

function test_every_post_has_a_title(): void {
    foreach (all_posts() as $post) {
        assert(!$post->title->isEmpty(), "post {$post->id} has no title");
    }
}

function test_find_post(): void {
    assert_eq(find_post(2)?->title, "Types without ceremony");
    assert_eq(find_post(99), null);
}

function test_excerpt_is_shortened(): void {
    $post = new Post(9, "Long", str_repeat("word ", 50), []);
    assert($post->excerpt(20)->len() <= 21);
    assert($post->excerpt(20)->endsWith("…"));
}
