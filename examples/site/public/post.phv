<?phv
import std.http.{request, response};
import lib.posts.find_post;

// ?string -> ?int: `?->` skips the call when the parameter is missing.
$id = request()->query("id")?->toInt();
$post = $id == null ? null : find_post($id);

if ($post == null) {
    response()->status(404);
    echo render("views/layout.phv.html", title: "Not found", body: raw("<h1>Post not found</h1>"));
    return;
}

echo render(
    "views/layout.phv.html",
    title: $post->title,
    body: render("views/post.phv.html", post: $post),
);
