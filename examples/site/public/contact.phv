<?phv
import std.http.request;

$req = request();
list<string> $errors = [];
$name = "";
$message = "";
$sent = false;

if ($req->isPost()) {
    $name = ($req->form("name") ?? "")->trim();
    $message = ($req->form("message") ?? "")->trim();
    if ($name->isEmpty()) {
        $errors[] = "Please enter your name.";
    }
    if ($message->len() < 5) {
        $errors[] = "The message must be at least 5 characters long.";
    }
    $sent = $errors->isEmpty();
}

$body = render(
    "views/contact.phv.html",
    name: $name,
    message: $message,
    errors: $errors,
    sent: $sent,
);
echo render("views/layout.phv.html", title: "Contact", body: $body);
