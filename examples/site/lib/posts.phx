// Blog data. A real site would load this from a database.

export class Post {
    public function __construct(
        public readonly int $id,
        public readonly string $title,
        public readonly string $body,
        public readonly list<string> $tags,
    ) {}

    public function excerpt(int $length = 90): string {
        if ($this->body->len() <= $length) {
            return $this->body;
        }
        return $this->body->slice(0, $length)->rtrim() . "…";
    }
}

export function all_posts(): list<Post> {
    return [
        new Post(
            1,
            "Hello, PHX",
            "PHX keeps what made PHP productive: save a file, reload the page, see the result. It adds static types, automatic HTML escaping and a register-based bytecode VM.",
            ["intro"],
        ),
        new Post(
            2,
            "Types without ceremony",
            "Variables are declared by assigning them, like in PHP, but their type is fixed by the first assignment.\nFunctions declare their parameter and return types, and nullable values must be checked before use.",
            ["types", "safety"],
        ),
        new Post(
            3,
            "Safe by default",
            "Everything printed with <?= ?> is HTML-escaped. Try typing <script>alert(1)</script> into the name field on the home page: it is shown as text, not run.",
            ["security"],
        ),
    ];
}

export function find_post(int $id): ?Post {
    return all_posts()->find(fn($p) => $p->id == $id);
}
