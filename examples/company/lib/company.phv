// The content of the landing page. A real site might load it from a CMS or a database.

export class Stat {
    public function __construct(
        public readonly string $value,
        public readonly string $unit,
        public readonly string $label,
    ) {}
}

export class Service {
    public function __construct(
        public readonly string $icon,
        public readonly string $title,
        public readonly string $text,
        public readonly list<string> $points,
    ) {}
}

export class Strength {
    public function __construct(
        public readonly string $title,
        public readonly string $text,
    ) {}
}

export class Work {
    public function __construct(
        public readonly string $tone,
        public readonly string $client,
        public readonly string $title,
        public readonly string $text,
        public readonly string $result,
        public readonly list<string> $tags,
    ) {}
}

export class Step {
    public function __construct(
        public readonly string $title,
        public readonly string $text,
        public readonly string $term,
    ) {}
}

export class News {
    public function __construct(
        public readonly string $date,
        public readonly string $category,
        public readonly string $title,
    ) {}

    // "2026-10-15" → "2026.10.15"
    public function displayDate(): string {
        return $this->date->replace("-", ".");
    }
}

export class Fact {
    public function __construct(
        public readonly string $label,
        public readonly string $value,
    ) {}
}

export function stats(): list<Stat> {
    return [
        new Stat("120", "社+", "お取引企業"),
        new Stat("96", "%", "プロジェクト継続率"),
        new Stat("8", "週間", "初回リリースまでの平均"),
    ];
}

export function services(): list<Service> {
    return [
        new Service(
            "web",
            "Webサービス開発",
            "新規事業の立ち上げから既存サービスのリニューアルまで。小さく作って素早く検証し、育てていく開発を得意としています。",
            ["MVP・プロトタイプ開発", "SaaS・会員サイト・EC", "既存システムの改修と移行"],
        ),
        new Service(
            "system",
            "業務システム・DX支援",
            "紙とExcelに散らばった業務を整理し、現場の方が毎日使いたくなるシステムに置き換えます。",
            ["業務フローの可視化と設計", "基幹システム・社内ツール開発", "データ連携と業務の自動化"],
        ),
        new Service(
            "design",
            "UI/UXデザイン",
            "使う人へのインタビューから画面設計、デザインシステムの構築まで、エンジニアと同じチームで進めます。",
            ["ユーザーリサーチ", "画面設計・プロトタイピング", "デザインシステム構築"],
        ),
    ];
}

export function strengths(): list<Strength> {
    return [
        new Strength(
            "企画から運用まで、ひとつのチームで",
            "ディレクター、デザイナー、エンジニアが最初から同じチームに入ります。伝言ゲームがないので、決めたことがそのまま形になります。",
        ),
        new Strength(
            "2週間ごとに、動くものをお見せします",
            "仕様書だけで何か月も待たせることはしません。2週間ごとに実際に触れる画面をお渡しし、ご意見をすぐ次に反映します。",
        ),
        new Strength(
            "安全で、長く使える技術を選びます",
            "型安全な言語とテストの自動化で、作ったあとも安心して手を入れられるシステムにします。このサイトも PHV で書かれています。",
        ),
