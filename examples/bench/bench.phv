<?phv
// Micro-benchmarks. Run with: phv run examples/bench/bench.phv
// (use a release build: cargo build --release; PHV_JIT=0 disables the JIT)

function fib(int $n): int {
    if ($n < 2) {
        return $n;
    }
    return fib($n - 1) + fib($n - 2);
}

function loop_sum(int $n): int {
    $sum = 0;
    for ($i = 0; $i < $n; $i++) {
        $sum += $i % 7;
    }
    return $sum;
}

function build_string(int $n): string {
    $s = "";
    foreach (0..$n as $_) {
        $s .= "x";
    }
    return $s;
}

function mandelbrot(int $size): int {
    $inside = 0;
    for ($y = 0; $y < $size; $y++) {
        for ($x = 0; $x < $size; $x++) {
            $cr = 2.5 * $x / $size - 2.0;
            $ci = 2.0 * $y / $size - 1.0;
            $zr = 0.0;
            $zi = 0.0;
            $k = 0;
            while ($k < 50 && $zr * $zr + $zi * $zi <= 4.0) {
                $t = $zr * $zr - $zi * $zi + $cr;
                $zi = 2.0 * $zr * $zi + $ci;
                $zr = $t;
                $k++;
            }
            if ($k == 50) {
                $inside++;
            }
        }
    }
    return $inside;
}

function concat_items(int $n): int {
    $total = 0;
    for ($i = 0; $i < $n; $i++) {
        $s = "item-" . $i . ": " . ($i * 0.5);
        if ($s < "item-5") {
            $total += strlen($s);
        }
    }
    return $total;
}

function map_filter(int $n): int {
    return range(1, $n)->map(fn($x) => $x * 2)->filter(fn($x) => $x % 3 == 0)->sum();
}

function count_keys(int $n): int {
    map<string, int> $counts = [];
    foreach (0..$n as $i) {
        $key = "k" . ($i % 1000);
        $counts[$key] = ($counts[$key] ?? 0) + 1;
    }
    return count($counts);
}

function sieve(int $n): int {
    list<bool> $prime = [];
    for ($i = 0; $i <= $n; $i++) {
        $prime[] = true;
    }
    $count = 0;
    for ($i = 2; $i <= $n; $i++) {
        if ($prime[$i]) {
            $count++;
            for ($j = $i * $i; $j <= $n; $j += $i) {
                $prime[$j] = false;
            }
        }
    }
    return $count;
}

function list_sum(int $n): float {
    list<float> $xs = [];
    for ($i = 0; $i < $n; $i++) {
        $xs[] = $i * 0.5;
    }
    $t = 0.0;
    foreach ($xs as $x) {
        $t += $x;
    }
    return $t;
}

class Builder {
    public string $text = "";
}

function prop_append(int $n): int {
    $b = new Builder();
    for ($i = 0; $i < $n; $i++) {
        $b->text .= "x";
    }
    return $b->text->len();
}

function string_equals(int $n): int {
    list<string> $words = ["alpha", "beta", "gamma", "delta"];
    $hits = 0;
    for ($i = 0; $i < $n; $i++) {
        if ($words[$i % 4] == "gamma") {
            $hits++;
        }
    }
    return $hits;
}

function html_escape_loop(int $n): int {
    $total = 0;
    for ($i = 0; $i < $n; $i++) {
        $total += strlen((string) escape("Tom & Jerry <b>said</b> \"hello\" to {$i} friends today"));
    }
    return $total;
}

class Point {
    public function __construct(public int $x, public int $y) {}
}

function new_objects(int $n): int {
    $sum = 0;
    for ($i = 0; $i < $n; $i++) {
        $p = new Point($i, 1);
        $sum += $p->y;
    }
    return $sum;
}

function throw_catch(int $n): int {
    $caught = 0;
    for ($i = 0; $i < $n; $i++) {
        try {
            throw new RuntimeException("failed");
        } catch (RuntimeException) {
            $caught++;
        }
    }
    return $caught;
}

function sort_by(int $n): int {
    list<int> $xs = [];
    for ($i = 0; $i < $n; $i++) {
        $xs[] = ($i * 7919) % $n;
    }
    $sorted = $xs->sortBy(fn(int $a, int $b): int => $b <=> $a);
    return $sorted[0];
}

function ms(float $start): string {
    return number_format((microtime() - $start) * 1000, 1) . " ms";
}

$t = microtime();
$r = fib(30);
echo "fib(30) = $r: ", ms($t), "\n";

$t = microtime();
$r = loop_sum(10000000);
echo "loop 10M: $r: ", ms($t), "\n";

$t = microtime();
$r = build_string(1000000)->len();
echo "append 1M chars ($r): ", ms($t), "\n";

$t = microtime();
$r = mandelbrot(300);
echo "mandelbrot 300x300 ($r inside): ", ms($t), "
";

$t = microtime();
$r = concat_items(1000000);
echo "concat 1M ($r): ", ms($t), "
";

$t = microtime();
$r = map_filter(1000000);
echo "map/filter 1M ($r): ", ms($t), "\n";

$t = microtime();
$r = count_keys(200000);
echo "map updates 200k ($r keys): ", ms($t), "\n";

$t = microtime();
$r = sieve(1000000);
echo "sieve 1M ($r primes): ", ms($t), "\n";

$t = microtime();
$f = list_sum(1000000);
echo "list of 1M floats ($f): ", ms($t), "\n";

$t = microtime();
$r = prop_append(200000);
echo "property .= 200k ($r): ", ms($t), "\n";

$t = microtime();
$r = string_equals(1000000);
echo "string == 1M ($r): ", ms($t), "\n";

$t = microtime();
$r = html_escape_loop(200000);
echo "escape() 200k ($r): ", ms($t), "\n";

$t = microtime();
$r = new_objects(1000000);
echo "new 1M ($r): ", ms($t), "\n";

$t = microtime();
$r = throw_catch(100000);
echo "throw/catch 100k ($r): ", ms($t), "\n";

$t = microtime();
$r = sort_by(200000);
echo "sortBy 200k ($r): ", ms($t), "\n";
