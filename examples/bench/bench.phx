<?phx
// Micro-benchmarks. Run with: phenix run examples/bench/bench.phx
// (use a release build: cargo build --release)

function fib(int $n): int {
    if ($n < 2) {
        return $n;
    }
    return fib($n - 1) + fib($n - 2);
}

function ms(float $start): string {
    return number_format((microtime() - $start) * 1000, 1) . " ms";
}

$t = microtime();
$r = fib(30);
echo "fib(30) = $r: ", ms($t), "\n";

$t = microtime();
$sum = 0;
for ($i = 0; $i < 10000000; $i++) {
    $sum += $i % 7;
}
echo "loop 10M: $sum: ", ms($t), "\n";

$t = microtime();
$s = "";
foreach (0..1000000 as $i) {
    $s .= "x";
}
echo "append 1M chars (", $s->len(), "): ", ms($t), "\n";

$t = microtime();
$xs = range(1, 1000000);
$total = $xs->map(fn($x) => $x * 2)->filter(fn($x) => $x % 3 == 0)->sum();
echo "map/filter 1M ($total): ", ms($t), "\n";

$t = microtime();
map<string, int> $counts = [];
foreach (0..200000 as $i) {
    $key = "k" . ($i % 1000);
    $counts[$key] = ($counts[$key] ?? 0) + 1;
}
echo "map updates 200k (", count($counts), " keys): ", ms($t), "\n";
