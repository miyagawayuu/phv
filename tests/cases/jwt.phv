PEM);
$rsaPublic = JwtKey::fromPem(<<<'PEM'
-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAv1yN07WXcVr/NAhuWM/t
MH6fiYArsV7ICmZShI0D+ZM+Y/8BA+1HBpHTedDM9Glguuz4Zwp91MFdDHAI5oAl
TnmlxWZMvE6UVguCmOFNN1Fdoz2oB5x3zmPDZMUCMdSEuAQCLo6LSvd4AECKZ8KQ
