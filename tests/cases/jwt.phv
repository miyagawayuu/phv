fA05VUKvSv8L9zlvZVQe2QOr5ulUVVjP1f4gRkG7l9Kz6VVQyuD/DVN77Q+08mCA
nraP/g7wAlgFPFBTOK5TFRcHVBKxUHvtORBNBzko7UmC8adHMcnzRk7j/Fwh9KwN
AQIDAQAB
-----END PUBLIC KEY-----
PEM, "rsa-1");
$ec = JwtKey::fromPem(<<<'PEM'
-----BEGIN EC PRIVATE KEY-----
MHcCAQEEIOUKJVuOXIQpvfvsvk32BsyjDtGg3owXA7+bXRBCOGqjoAoGCCqGSM49
AwEHoUQDQgAE0NkL9/wi28tJRrrt4MrK7KUYqaH+U9w+ckGoyOQ5uHws/pDDbsDk
GmvjACb2GoiHYgf/Ejup8kvI6WkIlW/p9A==
-----END EC PRIVATE KEY-----
PEM, "ec-1");
$ec8 = JwtKey::fromPem(<<<'PEM'
-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg5QolW45chCm9++y+
TfYGzKMO0aDejBcDv5tdEEI4aqOhRANCAATQ2Qv3/CLby0lGuu3gysrspRipof5T
3D5yQajI5Dm4fCz+kMNuwOQaa+MAJvYaiIdiB/8SO6nyS8jpaQiVb+n0
-----END PRIVATE KEY-----
PEM);
$ecPublic = JwtKey::fromPem(<<<'PEM'
-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE0NkL9/wi28tJRrrt4MrK7KUYqaH+
U9w+ckGoyOQ5uHws/pDDbsDkGmvjACb2GoiHYgf/Ejup8kvI6WkIlW/p9A==
-----END PUBLIC KEY-----
PEM);
$ed = JwtKey::fromPem(<<<'PEM'
-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEIGkr/9MmpIUPR4PUt7qYkjFbw/2J4snf4iTZnnLI40hs
-----END PRIVATE KEY-----
PEM, "ed-1");
$edPublic = JwtKey::fromPem(<<<'PEM'
-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAQLxFI3QAj40kqjoHZDk8fy2DlqkNMWmecyiARk5BIUY=
-----END PUBLIC KEY-----
PEM);

foreach ([$rsa, $rsa1, $rsaPublic, $ec, $ec8, $ecPublic, $ed, $edPublic] as $k) {
    echo $k->alg, " ", $k->kid ?? "-", " ", $k->canSign ? "private" : "public", "\n";
}

/** A claim of verified claims as text, or "refused". */
function field(?map<string, any> $claims, string $name): string {
    if ($claims == null) {
        return "refused";
    }
    $v = $claims[$name] ?? null;
    return $v is string ? $v : json_encode($v);
}

map<string, any> $claims = ["sub" => "7", "name" => "Ann", "exp" => time() + 60];
foreach ([[$rsa, $rsaPublic], [$rsa1, $rsaPublic], [$ec, $ecPublic], [$ec8, $ecPublic], [$ed, $edPublic]] as $pair) {
    $t = $pair[0]->sign($claims);
    echo $pair[0]->alg, ": ", field($pair[1]->verify($t), "name"), "\n";
}

// Public keys cannot sign.
try {
    $ecPublic->sign($claims);
} catch (ValueError $e) {
    echo "ValueError: ", $e->getMessage(), "\n";
}

// A key of another kind does not verify.
echo $ecPublic->verify($rsa->sign($claims)) == null ? "refused" : "accepted", "\n";
echo $edPublic->verify($ec->sign($claims)) == null ? "refused" : "accepted", "\n";

// The public JWK verifies what the private key signed.
$jwk = JwtKey::fromJwk($ec->publicJwk());
echo $jwk->alg, " ", $jwk->kid ?? "-", " ", $jwk->canSign ? "private" : "public", "\n";
echo field($jwk->verify($ec->sign($claims)), "sub"), "\n";

// A set picks the key by the token's kid.
$set = KeySet::of([$rsaPublic, $jwk, JwtKey::fromJwk($ed->publicJwk())]);
foreach ([$rsa, $ec, $ed] as $k) {
    echo $k->kid ?? "-", ": ", field($set->verify($k->sign($claims)), "sub"), "\n";
}
$published = KeySet::fromJson($set->toJson());
echo field($published->verify($ed->sign($claims)), "sub"), "\n";
echo count($set->toJson()->split("\"kty\"")) - 1, " keys\n";

// Expiry, not-before, issuer and audience.
$now = time();
function show(Verifier $v, string $token, ?string $iss = null, ?string $aud = null, int $leeway = 0): string {
    return $v->verify($token, issuer: $iss, audience: $aud, leeway: $leeway) == null ? "refused" : "ok";
}
echo "expired: ", show($ecPublic, $ec->sign(["exp" => $now - 10])), "\n";
echo "expired, leeway 30: ", show($ecPublic, $ec->sign(["exp" => $now - 10]), leeway: 30), "\n";
echo "not yet: ", show($ecPublic, $ec->sign(["nbf" => $now + 100])), "\n";
echo "exp as text: ", show($ecPublic, $ec->sign(["exp" => "9999999999"])), "\n";
$t = $ec->sign(["iss" => "https://id.example", "aud" => ["web", "api"]]);
echo "iss and aud: ", show($ecPublic, $t, "https://id.example", "api"), "\n";
echo "other iss: ", show($ecPublic, $t, "https://evil.example", "api"), "\n";
echo "other aud: ", show($ecPublic, $t, "https://id.example", "admin"), "\n";
echo "aud not asked for: ", show($ecPublic, $t, "https://id.example"), "\n";
echo "aud missing: ", show($ecPublic, $ec->sign(["sub" => "1"]), null, "api"), "\n";

// HS256 secrets.
$secret = JwtKey::secret("0123456789abcdef0123456789abcdef", "s1");
echo $secret->alg, " ", $secret->canSign ? "signs" : "-", " ", field($secret->verify($secret->sign(["a" => 1])), "a"), "\n";
try {
    $secret->publicJwk();
} catch (ValueError $e) {
    echo "ValueError: ", $e->getMessage(), "\n";
}
// A token signed with HS256 using a public key as the secret is refused.
$forged = JwtKey::secret($ec->publicJwk(), "ec-1")->sign(["sub" => "admin"]);
echo "forged: ", show($set, $forged), "\n";

// Tampered and malformed tokens.
$t = $ec->sign(["role" => "user"]);
$parts = $t->split(".");
$evil = $parts[0] . "." . base64_encode(json_encode(["role" => "admin"]))->replace("=", "") . "." . $parts[2];
echo "tampered: ", show($ecPublic, $evil), "\n";
echo "garbage: ", show($ecPublic, "a.b.c"), "\n";
echo "none: ", show($ecPublic, "eyJhbGciOiJub25lIn0.e30."), "\n";

// Bad keys.
foreach (["not a key", "-----BEGIN CERTIFICATE-----
AAAA
-----END CERTIFICATE-----", "-----BEGIN ENCRYPTED PRIVATE KEY-----
AAAA
-----END ENCRYPTED PRIVATE KEY-----"] as $bad) {
    try {
        JwtKey::fromPem($bad);
    } catch (ValueError $e) {
        echo "ValueError: ", $e->getMessage(), "\n";
    }
}
foreach (['{"kty":"oct","k":"AAAA"}', '{"kty":"EC","crv":"P-384","x":"AA","y":"AA"}', '{"kty":"RSA","n":"AQAB","e":"AQAB"}', '{"kty":"OKP","crv":"Ed25519","x":"AAAA","use":"enc"}'] as $bad) {
    try {
        JwtKey::fromJwk($bad);
    } catch (ValueError $e) {
        echo "ValueError: ", $e->getMessage(), "\n";
    }
}
// An RSA key whose modulus is zero is refused like other short keys (it used to
// stop the script with an internal error), and a key set skips it.
foreach (['{"kty":"RSA","n":"","e":"AQAB"}', '{"kty":"RSA","n":"AA","e":"AQAB"}'] as $bad) {
    try {
        JwtKey::fromJwk($bad);
    } catch (ValueError $e) {
        echo "ValueError: ", $e->getMessage(), "\n";
    }
}
try {
    JwtKey::fromPem("-----BEGIN RSA PUBLIC KEY-----\nMAgCAQACAwEAAQ==\n-----END RSA PUBLIC KEY-----\n");
} catch (ValueError $e) {
    echo "ValueError: ", $e->getMessage(), "\n";
}
$withZero = KeySet::fromJson('{"keys":[' . $ec->publicJwk() . ',{"kty":"RSA","n":"AA","e":"AQAB"}]}');
echo "zero key skipped: ", field($withZero->verify($ec->sign(["sub" => "7"])), "sub"), "\n";
try {
    JwtKey::secret("short");
} catch (ValueError $e) {
    echo "ValueError: ", $e->getMessage(), "\n";
}
try {
    KeySet::fromJson('{"keys":[{"kty":"oct","k":"AAAA"}]}');
} catch (ValueError $e) {
    echo "ValueError: ", $e->getMessage(), "\n";
}
try {
    $ecPublic->verify("x", leeway: 1000);
} catch (ValueError $e) {
    echo "ValueError: ", $e->getMessage(), "\n";
}
try {
    KeySet::fetch("nowhere", "/jwks.json");
} catch (NetworkError $e) {
    echo "NetworkError: ", $e->getMessage(), "\n";
}
