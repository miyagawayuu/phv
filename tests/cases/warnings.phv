<?phv
// Redundant null handling is allowed, with a warning.
$name = "Ann";
echo $name ?? "nobody", "\n";
echo $name?->upper(), "\n";

class Box {
    public function __construct(public string $label, public list<string> $items) {}
}
function find_box(bool $found): ?Box {
    return $found ? new Box("tools", ["hammer", "saw"]) : null;
}
// `?->` short-circuits the rest of the chain, as in PHP.
echo find_box(true)?->label->upper() ?? "none", "\n";
echo find_box(false)?->label->upper() ?? "none", "\n";
echo find_box(true)?->items[1] ?? "none", "\n";
echo find_box(false)?->items->len() ?? 0, "\n";
