<?phv
// Destructuring assignments and `foreach (... as [$a, $b])`.

[$a, $b] = [1, 2];
echo $a, " ", $b, "\n";
[$a, $b] = [$b, $a];
echo $a, " ", $b, "\n";

[$first, ...$rest] = ["x", "y", "z"];
echo $first, " ", $rest->join(","), "\n";

["name" => $name, "city" => $city] = ["name" => "Ada", "city" => "London", "x" => "?"];
echo $name, " in ", $city, "\n";

[[$p, $q], [$r, $_s]] = [[1, 2], [3, 4]];
echo $p + $q + $r, "\n";

class Point {
    public int $x = 0;
    public int $y = 0;
}
$pt = new Point();
list<int> $slots = [0, 0];
[$pt->x, $pt->y, $slots[1]] = [5, 6, 7];
echo $pt->x, ",", $pt->y, " ", $slots->join(","), "\n";

$pairs = [["a", "1"], ["b", "2"]];
foreach ($pairs as [$k, $v]) {
    echo $k, "=", $v, " ";
}
echo "\n";

$rows = ["r1" => ["id" => 1, "n" => 10], "r2" => ["id" => 2, "n" => 20]];
foreach ($rows as $key => ["id" => $id, "n" => $n]) {
    echo $key, ":", $id * $n, " ";
}
echo "\n";

function split_name(string $full): list<string> {
    return $full->split(" ");
}
[$given, $family] = split_name("Grace Hopper");
echo $family, ", ", $given, "\n";

try {
    [$one, $two] = [1];
    echo $one, $two;
} catch (IndexError $e) {
    echo "IndexError: ", $e->getMessage(), "\n";
}
