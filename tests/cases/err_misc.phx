<?phx
class Account {
    public function __construct(public readonly int $id, private int $balance) {}
}

function total(list<int> $xs): int {
    foreach ($xs as $x) {
        if ($x > 0) {
            return $x;
        }
    }
}

$a = new Account(1, 100);
$a->id = 2;
echo $a->balance;
eval("echo 1;");
echo total([1, 2], 3);
