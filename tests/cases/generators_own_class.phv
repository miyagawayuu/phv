<?phv
// A project's own class named `Generator` (from before 1.3) still works: it
// hides the built-in one in this file.
class Generator {
    public function __construct(private string $prefix) {}

    public function next(int $n): string {
        return $this->prefix . $n;
    }
}

function make(): Generator {
    return new Generator("id-");
}

$g = make();
echo $g->next(1), " ", $g->next(2), "\n";
$k = new Kid();
echo $k->yield(), "\n";

class Kid {
    // A method may still be named `yield`.
    public function yield(): string {
        return "kid";
    }
}
