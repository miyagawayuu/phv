<?phv
// What a `finally` assigns, or changes with a call, holds after the `try`; and
// what holds at a `continue` holds in a `for` step and a `do`-`while`
// condition (the checker used to forget both: found by the 1.2.0 audit).
interface Thing {}
class Box implements Thing {
    public function __construct(public string $label) {}
}
class Vault implements Thing {
    public function __construct(private string $secret) {}
}
class A {
    public ?A $p = null;
    public int $v = 7;
    public function __construct() {}
}
class Clear {
    public function run(A $a): void {
        $a->p = null;
    }
}

function retyped(Vault $v): string {
    Thing $x = new Box("box");
    try {
        if (!($x is Box)) {
            return "";
        }
    } finally {
        $x = $v;
    }
    return $x->label;
}

function nulled(?A $x): A {
    try {
        if ($x == null) {
            return new A();
        }
    } finally {
        $x = null;
    }
    return $x;
}

function cleared(A $a, Clear $c): int {
    if ($a->p == null) {
        return 0;
    }
    try {
        echo "work\n";
    } finally {
        $c->run($a);
    }
    return $a->p->v;
}

function do_continue(?A $x): int {
    $n = 0;
    do {
        $n++;
        if ($x == null) {
            continue;
        }
    } while ($x->v > 100);
    return $n;
}

function for_continue(?A $x): int {
    $n = 0;
    for ($i = 0; $i < 2; $n = $n + $x->v) {
        $i++;
        if ($x == null) {
            continue;
        }
    }
    return $n;
}

function continue_through_finally(?A $x): int {
    $n = 0;
    do {
        $n++;
        try {
            if ($x == null) {
                return 0;
            }
            continue;
        } finally {
            $x = null;
        }
    } while ($x->v > 100);
    return $n;
}

echo retyped(new Vault("secret")), nulled(new A())->v, cleared(new A(), new Clear());
echo do_continue(null), for_continue(null), continue_through_finally(new A());
