<?phx
$name = "PHX";
$version = 1;
echo "Hello, $name v{$version}!\n";
echo 'single $quoted\n', "\n";

// Arithmetic: int stays int, int/int division gives float.
echo 7 + 3 * 2, " ", 7 / 2, " ", intdiv(7, 2), " ", 7 % 3, " ", 2 ** 10, "\n";
echo 0.1 + 0.2, " ", 1.0 / 3.0, " ", 2.5 * 2, " ", -7 / 2, "\n";
echo 1e20, " ", 1.5e-7, " ", 10 / 4, "\n";

// int is promoted to float where a float is expected
function area(float $r): float {
    return 3.14159 * $r * $r;
}
echo round(area(2), 2), "\n";

$total = 0;
for ($i = 1; $i <= 10; $i++) {
    $total += $i;
}
echo "sum=$total\n";

$f = 1.5;
$f += 1;
echo "f=$f\n";

echo 3 <=> 5, " ", "b" <=> "a", " ", (5 > 3 ? "yes" : "no"), "\n";
echo (int)7.9, " ", (float)3, " ", (string)42 . "!", "\n";
echo max(3, 9), " ", min(2.5, 1), " ", abs(-4), " ", floor(2.7), " ", sqrt(16.0), "\n";
echo number_format(1234567.891, 2), " ", number_format(0.5), "\n";
echo 6 & 3, " ", 6 | 3, " ", 6 ^ 3, " ", 1 << 4, " ", -16 >> 2, " ", ~0, "\n";
