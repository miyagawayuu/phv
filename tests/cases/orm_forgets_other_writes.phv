<?phv
// A Repo forgets what it kept when another Repo writes to its table, and
// after ROLLBACK or COMMIT written as SQL: update() then writes every column
// instead of skipping one whose row no longer holds the entity's value
// (19th audit).
import std.db.Database;
import std.orm.Repo;

#[Table("users")]
class User {
    public ?int $id = null;
    public string $name = "";
}

#[Table("notes")]
class Note {
    public ?int $id = null;
    public string $body = "";
}

$db = Database::open(":memory:");
$db->execute(sql"CREATE TABLE users (id integer PRIMARY KEY, name text)");
$db->execute(sql"CREATE TABLE notes (id integer PRIMARY KEY, body text)");
$name = function () use ($db): string {
    return $db->first(sql"SELECT name FROM users")?->string("name") ?? "";
};
$a = new Repo<User>($db);
$b = new Repo<User>($db);
$u = new User();
$u->name = "mk1";
$a->insert($u);

// Another Repo writes the same entity.
$u->name = "mk2";
$b->update($u);
$u->name = "mk1";
echo "a->update(): ", $a->update($u) ? "true" : "false", "\n";
echo "entity: ", $u->name, ", row: ", $name(), "\n";

// A rollback written as SQL.
$db->execute(sql"SAVEPOINT s1");
$u->name = "mk3";
$a->update($u);
$db->execute(sql"ROLLBACK TO SAVEPOINT s1");
$db->execute(sql"RELEASE SAVEPOINT s1");
echo "a->update() after ROLLBACK TO: ", $a->update($u) ? "true" : "false", "\n";
echo "entity: ", $u->name, ", row: ", $name(), "\n";

// A Repo of another table does not make it forget: nothing changed, nothing is written.
$notes = new Repo<Note>($db);
$n = new Note();
$n->body = "x";
$notes->insert($n);
echo "a->update() with nothing changed: ", $a->update($u) ? "true" : "false", "\n";

// Two Repos of one table named in different case (SQLite reads table names
// without regard to case) forget each other's writes (20th audit).
#[Table("USERS")]
class Shouting {
    public ?int $id = null;
    public string $name = "";
}
$loud = new Repo<Shouting>($db);
$s = $loud->find($u->id ?? 0) ?? new Shouting();
$s->name = "loud";
$loud->update($s);
echo "a->update() after USERS was written: ", $a->update($u) ? "true" : "false", "\n";
echo "entity: ", $u->name, ", row: ", $name(), "\n";

// SQLite rolls back the script's own transaction for `INSERT OR ROLLBACK`
// and `RAISE(ROLLBACK)`, outside transaction() (20th audit).
$db->execute(sql"BEGIN");
$u->name = "mk4";
$a->update($u);
try {
    $db->execute(sql"INSERT OR ROLLBACK INTO users VALUES ({$u->id}, 'dup')");
} catch (DatabaseError $e) {
    echo "INSERT OR ROLLBACK: ", $e->getMessage(), "\n";
}
echo "a->update() after INSERT OR ROLLBACK: ", $a->update($u) ? "true" : "false", "\n";
echo "entity: ", $u->name, ", row: ", $name(), "\n";
$db->execute(sql"CREATE TRIGGER no_notes BEFORE INSERT ON notes BEGIN SELECT RAISE(ROLLBACK, 'no notes'); END");
$db->execute(sql"BEGIN");
$u->name = "mk5";
$a->update($u);
try {
    $db->execute(sql"INSERT INTO notes (body) VALUES ('y')");
} catch (DatabaseError $e) {
    echo "RAISE(ROLLBACK): ", $e->getMessage(), "\n";
}
echo "a->update() after RAISE(ROLLBACK): ", $a->update($u) ? "true" : "false", "\n";
echo "entity: ", $u->name, ", row: ", $name(), "\n";
