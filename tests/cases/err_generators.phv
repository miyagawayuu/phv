<?phv
// What the type checker refuses about generators.

function wrong_value(): Generator<int> {
    yield "one";
}

function no_return_type() {
    yield 1;
}

function not_a_generator_type(): list<int> {
    yield 1;
}

function returns_a_value(): Generator<int> {
    yield 1;
    return 5;
}

function needs_keys(): Generator<string, int> {
    yield 1;
}

function wrong_key(): Generator<string, int> {
    yield 1 => 1;
}

function in_finally(): Generator<int> {
    try {
        yield 1;
    } finally {
        yield 2;
    }
}

function from_wrong_values(): Generator<string> {
    yield from [1, 2];
}

function from_wrong_keys(): Generator<string, int> {
    yield from [1, 2];
}

function from_a_number(): Generator<int> {
    yield from 5;
}

class Maker {
    public function __construct() {
        yield 1;
    }
}

$closure = function () {
    yield 1;
};

function consume(): void {
    foreach (wrong_value() as $k => $v) {
        $s = $k . $v;
        $n = $v + 1;
        echo $s, $n;
    }
    list<string> $words = wrong_value()->toList();
    echo count($words);
}

yield 3;
