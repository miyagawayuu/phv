<?phv
$xs = [3, 1, 2];
$xs[] = 5;
$xs[0] = 4;
echo implode(",", $xs->map(fn($x) => (string)$x)), " count=", count($xs), "\n";

// Lists and maps are values: assignment copies (copy-on-write).
$ys = $xs;
$ys[] = 100;
echo $xs->len(), " ", $ys->len(), "\n";

$ages = ["alice" => 30, "bob" => 25];
$ages["carol"] = 35;
foreach ($ages as $name => $age) {
    echo "$name=$age ";
}
echo "\n";
echo $ages["bob"], " ", $ages["dave"] ?? 0, " ", $ages->has("alice") ? "has" : "no", "\n";
echo implode(",", $ages->keys()), " ", $ages->values()->sum(), "\n";

$evens = (1..=10)->filter(fn($n) => $n % 2 == 0);
echo $evens->join(" "), " sum=", $evens->sum(), "\n";
echo [5, 3, 9, 1]->sorted()->join(","), " ", ["pear", "apple", "fig"]->sorted()->join(","), "\n";
echo ["bb", "a", "ccc"]->sortBy(fn($a, $b) => $a->len() <=> $b->len())->join(","), "\n";
echo [1, 2, 3]->map(fn($x) => $x * 1.5)->join(" "), "\n";
echo [1, 2, 3, 4]->find(fn($x) => $x > 2) ?? 0, " ", [1, 2]->any(fn($x) => $x > 1) ? "any" : "none", "\n";
echo [1, 2, 2, 3, 1]->unique()->join(","), " ", [1, 2, 3]->reverse()->join(","), " ", [1, 2, 3, 4]->slice(1, 2)->join(","), "\n";
echo $xs->first() ?? 0, " ", $xs->last() ?? 0, " ", $xs->contains(5) ? "has 5" : "no 5", "\n";

// Nested values
map<string, list<int>> $groups = [];
$groups["odd"] = [];
$groups["even"] = [];
foreach (1..7 as $i) {
    if ($i % 2 == 0) {
        $groups["even"][] = $i;
    } else {
        $groups["odd"][] = $i;
    }
}
echo json_encode($groups), "\n";

list<list<int>> $grid = [[0, 0], [0, 0]];
$copy = $grid;
$grid[1][0] = 7;
echo json_encode($grid), " ", json_encode($copy), "\n";

$scores = ["math" => 90.5, "art" => 72];
echo json_encode($scores), "\n";
echo json_encode(["name" => "Ann", "tags" => ["a", "b"]]), "\n";
