<?phv
$factor = 3;
$times = fn(int $x): int => $x * $factor;
$factor = 100; // arrow functions capture by value at creation
echo $times(5), "\n";

function apply(fn(int): int $f, int $v): int {
    return $f($v);
}
echo apply(fn($x) => $x + 1, 41), "\n";

function makeCounter(): fn(): int {
    $count = 0;
    return function () use ($count): int {
        $count++;
        return $count;
    };
}
$next = makeCounter();
echo $next(), $next(), "\n"; // each call starts from the captured copy

$prefix = ">> ";
$lines = ["a", "b"]->map(fn($l) => $prefix . $l);
echo implode(" ", $lines), "\n";

$adder = fn(int $a) => fn(int $b) => $a + $b;
$add10 = $adder(10);
echo $add10(5), "\n";

$names = ["carol", "alice", "bob"];
$sorted = $names->sortBy(function (string $a, string $b): int {
    return $a <=> $b;
});
echo implode(",", $sorted), "\n";

class Greeter {
    public function __construct(private string $greeting) {}

    public function greetAll(list<string> $names): list<string> {
        return $names->map(fn($n) => "{$this->greeting}, $n");
    }
}
echo implode("; ", (new Greeter("Hi"))->greetAll(["Ann", "Bo"])), "\n";
