<?phv
// These functions compute with floats, so they are compiled to native code
// when the JIT is on; the results must match the interpreter.

function poly(float $x): float {
    return 3.0 * $x * $x - 2.5 * $x + 1.0 / 3.0 - -$x;
}

function harmonic(int $n): float {
    $s = 0.0;
    for ($i = 1; $i <= $n; $i++) {
        $s += 1.0 / $i;
    }
    return $s;
}

function newton_sqrt(float $x): float {
    $g = $x / 2.0;
    for ($i = 0; $i < 30; $i++) {
        $g = ($g + $x / $g) / 2.0;
    }
    return $g;
}

function power_sum(float $base, int $n): float {
    $s = 0.0;
    for ($i = 0; $i < $n; $i++) {
        $s += $base ** $i % 7.5;
    }
    return $s;
}

function compare(float $a, float $b): string {
    $out = "";
    if ($a == $b) {
        $out .= "== ";
    }
    if ($a != $b) {
        $out .= "!= ";
    }
    if ($a < $b) {
        $out .= "< ";
    }
    if ($a <= $b) {
        $out .= "<= ";
    }
    if ($a > $b) {
        $out .= "> ";
    }
    if ($a >= $b) {
        $out .= ">= ";
    }
    return $out . "<=> " . ($a <=> $b);
}

function compare_mixed(int $i, float $f): string {
    return ($i == $f ? "eq" : "ne") . " " . ($f < $i ? "lt" : "ge") . " " . ($i <=> $f) . " " . ($f <= $i ? "le" : "gt");
}

function inf(): float {
    return 1.0e308 * 10.0;
}

function nan(): float {
    return inf() - inf();
}

function neg_zero(): float {
    return -0.0 * 1.0;
}

function divide(float $a, float $b): float {
    return $a / $b;
}

function modulo(float $a, float $b): float {
    return $a % $b;
}

function to_int(float $f): int {
    return (int) $f;
}

function round_trip(int $i): int {
    return (int) ((float) $i * 1.5);
}

function fact(float $n): float {
    return $n <= 1.0 ? 1.0 : $n * fact($n - 1.0);
}

function count_steps(float $x): int {
    $steps = 0;
    while ($x > 1.0) {
        $x = $x / 3.0;
        $steps++;
    }
    return $steps;
}

function is_small(float $x): bool {
    return $x < 0.001 && $x > -0.001;
}

echo poly(1.5), " ", poly(-2.25), " ", harmonic(1000), " ", newton_sqrt(2.0), " ", power_sum(1.1, 50), "\n";
echo fact(20.0), " ", fact(170.0), " ", fact(171.0), " ", count_steps(1.0e12), " ", is_small(0.0001) ? "small" : "big", "\n";
echo to_int(3.99), " ", to_int(-3.99), " ", to_int(-9.2233720368547758e18), " ", round_trip(7), " ", round_trip(-7), "\n";
echo compare(1.0, 2.0), " | ", compare(2.0, 1.0), " | ", compare(1.5, 1.5), "\n";
echo compare(nan(), 1.0), " | ", compare(nan(), nan()), "\n";
echo compare(0.0, neg_zero()), " | ", neg_zero(), " ", -neg_zero(), " ", 1.0 / inf(), " ", -1.0 / inf(), "\n";
echo compare(inf(), 1.0e308), " | ", inf(), " ", -inf(), " ", nan(), "\n";
echo compare_mixed(3, 3.0), " | ", compare_mixed(3, 3.5), " | ", compare_mixed(9007199254740993, 9007199254740992.0), "\n";
echo divide(1.0, 3.0), " ", modulo(7.5, 2.0), " ", modulo(-7.5, 2.0), " ", modulo(7.5, -0.5), " ", modulo(1.0, inf()), "\n";

try {
    echo divide(1.0, 0.0);
} catch (DivisionByZeroError $e) {
    echo "caught: ", $e->getMessage(), "\n";
}
try {
    echo divide(1.0, neg_zero());
} catch (DivisionByZeroError $e) {
    echo "caught: ", $e->getMessage(), "\n";
}
try {
    echo modulo(1.0, 0.0);
} catch (DivisionByZeroError $e) {
    echo "caught: ", $e->getMessage(), "\n";
}
foreach ([9.2233720368547758e18, -9.3e18, inf(), nan()] as $f) {
    try {
        echo to_int($f), "\n";
    } catch (ValueError $e) {
        echo "caught: ", $e->getMessage(), "\n";
    }
}
echo divide(nan(), 2.0), " ", modulo(nan(), 2.0), " ", divide(5.0, nan()), "\n";
