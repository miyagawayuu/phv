export class Product {
    public function __construct(
        public readonly string $name,
        public readonly float $price,
        public readonly bool $inStock,
    ) {}

    public function label(): string {
        return $this->name . " ($" . number_format($this->price, 2) . ")";
    }
}

export function catalog(): list<Product> {
    return [
        new Product("Hammer", 12.5, true),
        new Product("<script>alert('x')</script>", 0.99, false),
        new Product("Saw", 1250, true),
    ];
}

function internal_discount(): float {
    return 0.1;
}
