// Runs after mysql.phx on the same pooled connection.
import std.db.Database;

$db = Database::connect("main");
try {
    $db->query(sql"SELECT * FROM phx_temp");
    echo "temp table: still there\n";
} catch (DatabaseError $e) {
    echo "temp table: gone\n";
}
echo "variable: ", $db->first(sql"SELECT @leaked AS v")?->string("v") ?? "unset", "\n";
echo "uncommitted rows: ", count($db->query(sql"SELECT id FROM phx_items WHERE name = 'uncommitted'")), "\n";
$db->execute(sql"DROP TABLE phx_items");
