// Run by crates/phv_driver/tests/databases.rs: statements in the background.
import std.db.Database;
import std.async.{await, await_all};

$db = Database::connect("main");
$db->execute(sql"DROP TABLE IF EXISTS phv_async");
$db->execute(sql"CREATE TABLE phv_async (n int)");
$counts = await_all([
    $db->executeAsync(sql"INSERT INTO phv_async (n) VALUES (1)"),
    $db->executeAsync(sql"INSERT INTO phv_async (n) VALUES (2)"),
]);
echo "inserted: ", $counts[0] + $counts[1], "\n";
// Two statements of one second each, at the same time.
$a = $db->queryAsync(sql"SELECT pg_sleep(1), 1 AS one");
$b = $db->queryAsync(sql"SELECT pg_sleep(1), 2 AS two");
echo "one: ", (await($a)[0]->int("one") ?? 0), ", two: ", (await($b)[0]->int("two") ?? 0), "\n";
$rows = await($db->queryAsync(sql"SELECT n FROM phv_async ORDER BY n"));
echo "rows: ", $rows->map(fn($r) => (string)($r->int("n") ?? 0))->join(","), "\n";
$broken = $db->queryAsync(sql"SELECT * FROM phv_no_such_table");
try {
    await($broken);
} catch (DatabaseError) {
    echo "error caught\n";
}
$db->execute(sql"DROP TABLE phv_async");
