<?phv
// Run by crates/phv_driver/tests/databases.rs: a transaction that adds a job
// with the key "f1" and holds it fourteen seconds, then rolls back (so the
// key is never taken for good).
import std.db.Database;
import std.jobs.enqueue;

$db = Database::connect("main");
enqueue("k", "setup");
$pg = ($db->first(sql"SELECT version() AS v")?->string("v") ?? "")->startsWith("PostgreSQL");
try {
    $db->transaction(function () use ($db, $pg): void {
        enqueue("k", "held", key: "f1");
        if ($pg) {
            $db->query(sql"SELECT pg_sleep(14)");
        } else {
            $db->query(sql"SELECT SLEEP(14)");
        }
        throw new RuntimeException("rolled back");
    });
} catch (RuntimeException $e) {
    echo $e->getMessage();
}
