// Run by crates/phx_driver/tests/databases.rs against a Redis server.
import std.db.{Database, Redis};

$r = Redis::connect("main");
$r->delete("phx:greeting");
echo "missing: ", $r->get("phx:greeting") ?? "null", "\n";
$r->set("phx:greeting", "hello ?", 60);
echo "get: ", $r->get("phx:greeting") ?? "null", "\n";
echo "exists: ", $r->exists("phx:greeting") ? "yes" : "no", "\n";
$ttl = $r->ttl("phx:greeting");
echo "ttl ok: ", $ttl > 0 && $ttl <= 60 ? "yes" : "no", "\n";
$r->set("phx:greeting", "plain");
echo "ttl after plain set: ", $r->ttl("phx:greeting"), "\n";
echo "expire: ", $r->expire("phx:greeting", 30) ? "yes" : "no", "\n";
echo "delete: ", $r->delete("phx:greeting") ? "yes" : "no", " ", $r->delete("phx:greeting") ? "yes" : "no", "\n";

$r->delete("phx:counter");
echo "incr: ", $r->incr("phx:counter"), " ", $r->incr("phx:counter", 10), " ", $r->incr("phx:counter", -3), "\n";
$r->set("phx:text", "abc");
try {
    $r->incr("phx:text");
} catch (DatabaseError $e) {
    echo "error: ", $e->message, "\n";
}

$r->delete("phx:user");
echo "hset: ", $r->hset("phx:user", "name", "Ann") ? "new" : "old", " ", $r->hset("phx:user", "name", "Bo") ? "new" : "old", "\n";
$r->hset("phx:user", "city", "Kyoto");
echo "hget: ", $r->hget("phx:user", "name") ?? "null", " ", $r->hget("phx:user", "nope") ?? "null", "\n";
echo "hgetAll: ", json_encode($r->hgetAll("phx:user")), "\n";
echo "hdel: ", $r->hdel("phx:user", "city") ? "yes" : "no", "\n";

$r->delete("phx:queue");
$r->rpush("phx:queue", "a");
$r->rpush("phx:queue", "b");
echo "rpush: ", $r->rpush("phx:queue", "c"), "\n";
echo "lrange: ", json_encode($r->lrange("phx:queue", 0, -1)), "\n";
echo "lpop: ", $r->lpop("phx:queue") ?? "null", "\n";
echo "lrange: ", json_encode($r->lrange("phx:queue", 0, -1)), "\n";

try {
    Database::connect("main");
} catch (DatabaseError $e) {
    echo "error: ", $e->message, "\n";
}
foreach (["phx:counter", "phx:text", "phx:user", "phx:queue"] as $k) {
    $r->delete($k);
}
$r->close();
try {
    $r->get("x");
} catch (DatabaseError $e) {
    echo "error: ", $e->message, "\n";
}
