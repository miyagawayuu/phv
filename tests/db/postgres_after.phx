// Runs after postgres.phx on the same pooled connection.
import std.db.Database;

$db = Database::connect("main");
echo "temp table: ", $db->first(sql"SELECT to_regclass('pg_temp.phx_temp')::text AS t")?->string("t") ?? "gone", "\n";
echo "application_name: ", $db->first(sql"SELECT current_setting('application_name') AS a")?->string("a") ?? "", "\n";
echo "uncommitted rows: ", count($db->query(sql"SELECT id FROM phx_items WHERE name = 'uncommitted'")), "\n";
$db->execute(sql"DROP TABLE phx_items");
