// A list larger than the memory limit allows (run with a 16 MB limit).
import std.db.Redis;

$r = Redis::connect("main");
$r->delete("t:big");
$chunk = str_repeat("x", 1000000);
for ($i = 0; $i < 40; $i++) {
    $r->rpush("t:big", $chunk);
}
echo "pushed\n";
$items = $r->lrange("t:big", 0, -1);
echo "not reached: ", count($items), "\n";
