// Run by crates/phv_driver/tests/databases.rs: Redis commands in the background.
import std.db.Redis;
import std.async.{await, await_all};

$r = Redis::connect("main");
await_all([$r->setAsync("t:async:a", "1", 60), $r->setAsync("t:async:b", "2")]);
$a = $r->getAsync("t:async:a");
$b = $r->getAsync("t:async:b");
$none = $r->getAsync("t:async:none");
echo "a=", await($a) ?? "null", " b=", await($b) ?? "null", " none=", await($none) ?? "null", "\n";
$r->delete("t:async:a");
$r->delete("t:async:b");
