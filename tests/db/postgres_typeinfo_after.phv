<?phv
// Run by crates/phv_driver/tests/databases.rs after the postgres_typeinfo_*
// scripts, on a connection of the same pool: a type not looked up yet on it.
import std.db.Database;

$db = Database::connect("main");
try {
    echo $db->first(sql"SELECT 'y'::phv_ti_b::text AS v, 'y'::phv_ti_b AS t")?->string("v") ?? "?", "\n";
} catch (DatabaseError $e) {
    echo "error: ", $e->getMessage(), "\n";
}
