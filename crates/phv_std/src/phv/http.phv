// std.http — the current request, the response and the session.
//
//   import std.http.{request, response, session};
//   $name = request()->query("name") ?? "world";

export class UploadedFile {
    public function __construct(
        private int $index,
        public readonly string $field,
        /** The client's file name (directory parts removed). Do not trust it as a path. */
        public readonly string $name,
        public readonly string $type,
        public readonly int $size,
    ) {}

    /** The contents as text (invalid UTF-8 is replaced). */
    public function text(): string {
        return __upload_text($this->index);
    }

    /** Saves the file; the path must be inside a [permissions].write directory. */
    public function saveTo(string $path): void {
        __upload_save($this->index, $path);
    }
}

export class Request {
    public function __construct(
        public readonly string $method,
        public readonly string $path,
        public readonly map<string, string> $queryParams,
        public readonly map<string, string> $formParams,
        public readonly map<string, string> $headers,
        public readonly map<string, string> $cookies,
        public readonly list<UploadedFile> $files,
        public readonly string $body,
        /** The client's IP address (the proxy's, behind a reverse proxy). */
        public readonly string $ip,
        /** The parameters of the page's path: `id` for `public/posts/[id].phv`. */
        public readonly map<string, string> $params = [],
    ) {}

    /** A parameter of the page's path (`[id]` in its file name), or null. */
    public function param(string $name): ?string {
        return $this->params[$name] ?? null;
    }

    /** A query string parameter (`?name=value`), or null. */
    public function query(string $name): ?string {
        return $this->queryParams[$name] ?? null;
    }

    /** A form field (urlencoded or multipart POST body), or null. */
    public function form(string $name): ?string {
        return $this->formParams[$name] ?? null;
    }

    /**
     * Every value of a query parameter that appears more than once
     * (`?tag=a&tag=b`), in order. query() returns only one of them.
     */
    public function queryAll(string $name): list<string> {
        return __req_query_all($name);
    }

    /**
     * Every value of a form field sent more than once, such as checkboxes that
     * share a name (`<input type="checkbox" name="ids" value="3">`), in order.
     * form() returns only one of them.
     */
    public function formAll(string $name): list<string> {
        return __req_form_all($name);
    }

    /** A request header (case-insensitive), or null. */
    public function header(string $name): ?string {
        return $this->headers[$name->lower()] ?? null;
    }

    public function cookie(string $name): ?string {
        return $this->cookies[$name] ?? null;
    }

    /** An uploaded file from a multipart form, or null. */
    public function file(string $field): ?UploadedFile {
        return $this->files->find(fn($f) => $f->field == $field);
    }

    /** The body parsed as JSON. Throws ValueError for invalid JSON. */
    public function json(): any {
        return json_decode($this->body);
    }

    public function isPost(): bool {
        return $this->method == "POST";
    }
}

export class Response {
    public function status(int $code): Response {
        __resp_status($code);
        return $this;
    }

    /** Sets a response header. Line breaks in values are rejected. */
    public function header(string $name, string $value): Response {
        __resp_header($name, $value);
        return $this;
    }

    /** Sets the Content-Type. Output is HTML-escaped only for `text/html`. */
    public function type(string $contentType): Response {
        __resp_type($contentType);
        return $this;
    }

    /**
     * Sets a cookie. Cookies are HttpOnly and SameSite=Lax unless told otherwise;
     * `$maxAge` 0 means "until the browser closes".
     */
    public function cookie(
        string $name,
        string $value,
        int $maxAge = 0,
        string $path = "/",
        bool $secure = false,
        bool $httpOnly = true,
        string $sameSite = "Lax",
    ): Response {
        __resp_cookie($name, $value, $maxAge, $path, $secure, $httpOnly, $sameSite);
        return $this;
    }

    public function deleteCookie(string $name, string $path = "/"): Response {
        __resp_cookie($name, "", -1, $path, false, true, "Lax");
        return $this;
    }

    /**
     * Redirects to a path on this site ("/login", "/posts?id=2"). Other URLs are
     * rejected (open-redirect protection); use redirectExternal() for those.
     */
    public function redirect(string $path, int $code = 302): void {
        if (!__is_local_path($path)) {
            throw new ValueError("redirect() only accepts paths on this site; use redirectExternal()");
        }
        __resp_status($code);
        __resp_header("Location", $path);
    }

    /** Redirects to an absolute http(s) URL on another site. */
    public function redirectExternal(string $url, int $code = 302): void {
        if (!__is_http_url($url)) {
            throw new ValueError("redirectExternal() needs an http:// or https:// URL");
        }
        __resp_status($code);
        __resp_header("Location", $url);
    }

    /**
     * Sends a file instead of the page output, for example an uploaded image kept
     * in `data/`. The path needs [permissions].read or write. Without `$type` the
     * Content-Type comes from the extension; HTML, SVG and unknown files are sent
     * as `application/octet-stream`.
     */
    public function file(string $path, string $type = ""): void {
        __resp_file($path, $type);
    }

    /** Sends `$value` as JSON. */
    public function json(any $value): void {
        __resp_type("application/json");
        echo json_encode($value);
    }
}

/**
 * The visitor's session, stored on the server. Values are strings; use
 * json_encode / json_decode for structured data. Call regenerate() after login.
 */
export class Session {
    public function get(string $key): ?string {
        return __sess_get($key);
    }

    public function set(string $key, string $value): void {
        __sess_set($key, $value);
    }

    public function has(string $key): bool {
        return __sess_get($key) != null;
    }

    public function remove(string $key): void {
        __sess_remove($key);
    }

    public function all(): map<string, string> {
        return __sess_all();
    }

    /** Issues a new session id, keeping the values. */
    public function regenerate(): void {
        __sess_regenerate();
    }

    /** Deletes the session and its values. */
    public function destroy(): void {
        __sess_destroy();
    }

    /** Reads and removes a one-time message (e.g. "Saved!"). */
    public function flash(string $key): ?string {
        $v = __sess_get($key);
        __sess_remove($key);
        return $v;
    }
}

export function request(): Request {
    $files = __req_files()->map(fn($f) => new UploadedFile(
        ($f["index"] ?? "0")->toInt() ?? 0,
        $f["field"] ?? "",
        $f["name"] ?? "",
        $f["type"] ?? "",
        ($f["size"] ?? "0")->toInt() ?? 0,
    ));
    return new Request(
        __req_method(),
        __req_path(),
        __req_query(),
        __req_form(),
        __req_headers(),
        __req_cookies(),
        $files,
        __req_body(),
        __req_ip(),
        __req_params(),
    );
}

/**
 * Values that `_middleware.phv` passes on to the page of the same request,
 * such as the signed-in user's id. They last for one request.
 */
export class Locals {
    public function get(string $key): ?string {
        return __locals_get($key);
    }

    public function set(string $key, string $value): void {
        __locals_set($key, $value);
    }

    public function has(string $key): bool {
        return __locals_get($key) != null;
    }

    public function all(): map<string, string> {
        return __locals_all();
    }
}

export function locals(): Locals {
    return new Locals();
}

export function response(): Response {
    return new Response();
}

export function session(): Session {
    return new Session();
}

/**
 * The id of this request, with `[server] request_ids = true` in phv.toml
 * (otherwise null). The server sends it in the `X-Request-Id` header, writes
 * it in the JSON access log and adds it to the lines of `log_info()`,
 * `log_warn()` and `log_error()`, so the lines of one request can be found.
 */
export function request_id(): ?string {
    return __request_id();
}
