// Declarations visible in every PHV file.

class Exception {
    // Filled in by the runtime where the exception is first thrown.
    private string $trace = "";
    // Not promoted: exceptions the runtime throws get these defaults.
    protected int $code = 0;
    protected ?Exception $previous = null;

    public function __construct(public string $message = "", int $code = 0, ?Exception $previous = null) {
        $this->code = $code;
        $this->previous = $previous;
    }

    public function getMessage(): string {
        return $this->message;
    }

    public function getCode(): int {
        return $this->code;
    }

    // The exception this one was thrown because of (`previous:` in the constructor).
    public function getPrevious(): ?Exception {
        return $this->previous;
    }

    // Where it was first thrown: one `at function (file:line)` line per call, innermost first.
    // The runtime keeps the place; the text is made the first time it is asked for.
    public function getTraceAsString(): string {
        if ($this->trace == "") {
            $this->trace = __exc_trace($this);
        }
        return $this->trace;
    }
}

class RuntimeException extends Exception {}
class LogicException extends Exception {}
class InvalidArgumentException extends LogicException {}

// Thrown by the runtime.
class ArithmeticError extends Exception {}
class DivisionByZeroError extends ArithmeticError {}
class IndexError extends Exception {}
class KeyError extends Exception {}
class ValueError extends Exception {}
class UnhandledMatchError extends Exception {}
class PermissionError extends Exception {}
class DatabaseError extends RuntimeException {}
class NetworkError extends RuntimeException {}
class AssertionError extends Exception {}

// What a function with `yield` returns: its keys and values, made one at a time
// as a `foreach` asks for them. `Generator<V>` is short for `Generator<int, V>`.
// Only calling such a function makes one, and it can be iterated once.
final class Generator<K, V> {
    private function __construct() {}

    // Runs the generator to its end and gives its values, in order (the keys are dropped).
    public function toList(): list<V> {
        list<V> $values = [];
        foreach ($this as $value) {
            $values[] = $value;
        }
        return $values;
    }
}
