// std.net — WebSocket servers and HTTP services named in phv.toml.
//
//   import std.net.{HttpClient, WebSocket};
//
//   $api = HttpClient::connect("weather");  // [http.weather] in phv.toml
//   $res = $api->get("/forecast", ["city" => "Tokyo"]);
//   if ($res->ok()) {
//       $data = $res->json();
//   }
//   $res = $api->postJson("/reports", ["city" => "Tokyo", "temp" => 21]);
//
//   $ws = WebSocket::connect("game");       // [websockets.game] in phv.toml
//   $ws->send("hello");
//   $reply = $ws->receive(5.0);             // ?string: null when nothing arrives within 5 seconds
//   $ws->close();
//
// Each WebSocket::connect() opens a new connection, closed by close() or when the script ends.
// Each HTTP request uses its own connection; redirects are not followed.
// Network failures and a server closing the connection raise NetworkError.

/** The answer to an HTTP request. Header names are lowercase. */
import std.async.Future;

export class HttpResponse {
    public function __construct(
        public readonly int $status,
        public readonly map<string, string> $headers,
        public readonly string $body,
    ) {}

    /** A 2xx status. */
    public function ok(): bool {
        return $this->status >= 200 && $this->status < 300;
    }

    /** A header's value (names are matched without regard to case), or null. */
    public function header(string $name): ?string {
        return $this->headers[$name->lower()] ?? null;
    }

    /** The body decoded as JSON. Throws ValueError when it is not valid JSON. */
    public function json(): any {
        return json_decode($this->body);
    }
}

/** An HTTP service named `[http.<name>]` in phv.toml. Paths are added to its base URL. */
export class HttpClient {
    private function __construct(private string $name) {}

    public static function connect(string $name): HttpClient {
        return new HttpClient($name);
    }

    public function get(string $path, map<string, string> $query = [], map<string, string> $headers = []): HttpResponse {
        return $this->request("GET", $path, "", $headers, $query);
    }

    public function delete(string $path, map<string, string> $query = [], map<string, string> $headers = []): HttpResponse {
        return $this->request("DELETE", $path, "", $headers, $query);
    }

    public function post(string $path, string $body = "", map<string, string> $headers = []): HttpResponse {
        return $this->request("POST", $path, $body, $headers);
    }

    public function put(string $path, string $body = "", map<string, string> $headers = []): HttpResponse {
        return $this->request("PUT", $path, $body, $headers);
    }

    public function patch(string $path, string $body = "", map<string, string> $headers = []): HttpResponse {
        return $this->request("PATCH", $path, $body, $headers);
    }

    /** Sends `$data` as JSON (`Content-Type: application/json` unless `$headers` sets it). */
    public function postJson(string $path, any $data, map<string, string> $headers = []): HttpResponse {
        return $this->request("POST", $path, json_encode($data), ["Content-Type" => "application/json"]->merge($headers));
    }

    public function putJson(string $path, any $data, map<string, string> $headers = []): HttpResponse {
        return $this->request("PUT", $path, json_encode($data), ["Content-Type" => "application/json"]->merge($headers));
    }

    /** Sends `$fields` as a form (`application/x-www-form-urlencoded`). */
    public function postForm(string $path, map<string, string> $fields, map<string, string> $headers = []): HttpResponse {
        $body = http_build_query($fields);
        return $this->request("POST", $path, $body, ["Content-Type" => "application/x-www-form-urlencoded"]->merge($headers));
    }

    /** Any method (GET, HEAD, POST, PUT, PATCH, DELETE or OPTIONS). */
    public function request(
        string $method,
        string $path,
        string $body = "",
        map<string, string> $headers = [],
        map<string, string> $query = [],
    ): HttpResponse {
        return HttpClient::response(__http_request($this->name, $method, $path, $query, $headers, $body));
    }

    /** `get()` sent in the background: wait for the response with `await()` (std.async). */
    public function getAsync(string $path, map<string, string> $query = [], map<string, string> $headers = []): Future<HttpResponse> {
        return $this->requestAsync("GET", $path, "", $headers, $query);
    }

    public function postAsync(string $path, string $body = "", map<string, string> $headers = []): Future<HttpResponse> {
        return $this->requestAsync("POST", $path, $body, $headers);
    }

    public function postJsonAsync(string $path, any $data, map<string, string> $headers = []): Future<HttpResponse> {
        return $this->requestAsync("POST", $path, json_encode($data), ["Content-Type" => "application/json"]->merge($headers));
    }

    /** `request()` sent in the background. */
    public function requestAsync(
        string $method,
        string $path,
        string $body = "",
        map<string, string> $headers = [],
        map<string, string> $query = [],
    ): Future<HttpResponse> {
        $id = __http_start($this->name, $method, $path, $query, $headers, $body);
        return new Future(fn(): HttpResponse => HttpClient::response(__async_map($id)));
    }

    private static function response(map<string, any> $r): HttpResponse {
        $status = $r["status"] ?? 0;
        $hs = $r["headers"] ?? null;
        $text = $r["body"] ?? "";
        map<string, string> $headerMap = [];
        if ($hs is map) {
            foreach ($hs as $k => $v) {
                if ($k is string && $v is string) {
                    $headerMap[$k] = $v;
                }
            }
        }
        return new HttpResponse($status is int ? $status : 0, $headerMap, $text is string ? $text : "");
    }
}

export class WebSocket {
    /** Connections come from `WebSocket::connect()`; a handle number cannot be passed in. */
    private function __construct(private int $handle) {}

    /** Connects to the server named `[websockets.<name>]` in phv.toml. */
    public static function connect(string $name): WebSocket {
        return new WebSocket(__ws_connect($name));
    }

    /** Sends one text message. */
    public function send(string $text): void {
        __ws_send($this->handle, $text);
    }

    /** The next text message, or null when none arrives within `$timeout` seconds. */
    public function receive(float $timeout = 5.0): ?string {
        return __ws_receive($this->handle, $timeout);
    }

    public function close(): void {
        __ws_close($this->handle);
    }
}
