{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PHX Template",
  "scopeName": "text.html.phx",
  "comment": "HTML with embedded PHX: `<?phx ... ?>` blocks and `<?= ... ?>` output. The injection lets the blocks appear anywhere, including inside attribute values and <script>.",
  "injections": {
    "L:text.html.phx - meta.embedded.block.phx - comment.block.phx - string.quoted.double.phx - string.quoted.single.phx": {
      "patterns": [{ "include": "#embedded" }]
    }
  },
  "patterns": [
    { "include": "#embedded" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "embedded": {
      "begin": "<\\?(?:phx|=)",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.phx" } },
      "end": "\\?>",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.phx" } },
      "name": "meta.embedded.block.phx",
      "contentName": "source.phx",
      "patterns": [{ "include": "source.phx#code" }]
    }
  }
}
