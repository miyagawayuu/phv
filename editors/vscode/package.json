{
  "name": "phv-language",
  "displayName": "PHV Language",
  "description": "PHV language support: syntax highlighting for .phv and .phv.html, and diagnostics, hover types, completion and go to definition from `phv lsp`.",
  "version": "0.5.1",
  "publisher": "phv-lang",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://phv-lang.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/miyagawayuu/phv"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "phv",
        "aliases": [
          "PHV",
          "phv"
        ],
        "extensions": [
          ".phv"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/phv-file.svg",
          "dark": "./images/phv-file.svg"
        }
      },
      {
        "id": "phv-template",
        "aliases": [
          "PHV Template"
        ],
        "filenamePatterns": [
          "*.phv.html"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/phv-file.svg",
          "dark": "./images/phv-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "phv",
        "scopeName": "source.phv",
        "path": "./syntaxes/phv.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.phv": "html",
          "source.sql": "sql",
          "source.js": "javascript",
          "source.css": "css"
        }
      },
      {
        "language": "phv-template",
        "scopeName": "text.html.phv",
        "path": "./syntaxes/phv-html.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.phv": "phv",
          "source.sql": "sql",
          "source.js": "javascript",
          "source.css": "css"
        }
      }
    ],
    "configuration": {
      "title": "PHV",
      "properties": {
        "phv.path": {
          "type": "string",
          "default": "phv",
          "scope": "machine",
          "description": "The phv executable used for the language server. A user setting only: a workspace cannot change which program runs."
        },
        "phv.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start `phv lsp` for diagnostics, hover types, completion and go to definition."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/grammar.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
