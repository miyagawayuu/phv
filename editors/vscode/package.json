{
  "name": "phx",
  "displayName": "PHX Language",
  "description": "PHX language support: syntax highlighting for .phx and .phx.html, and diagnostics and hover types from `phx lsp`.",
  "version": "0.2.5",
  "publisher": "phx-lang",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://phx-lang.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/miyagawayuu/phx"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "phx",
        "aliases": ["PHX", "phx"],
        "extensions": [".phx"],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./images/phx-file.svg", "dark": "./images/phx-file.svg" }
      },
      {
        "id": "phx-template",
        "aliases": ["PHX Template"],
        "filenamePatterns": ["*.phx.html"],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./images/phx-file.svg", "dark": "./images/phx-file.svg" }
      }
    ],
    "grammars": [
      {
        "language": "phx",
        "scopeName": "source.phx",
        "path": "./syntaxes/phx.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.phx": "html",
          "source.sql": "sql",
          "source.js": "javascript",
          "source.css": "css"
        }
      },
      {
        "language": "phx-template",
        "scopeName": "text.html.phx",
        "path": "./syntaxes/phx-html.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.phx": "phx",
          "source.sql": "sql",
          "source.js": "javascript",
          "source.css": "css"
        }
      }
    ],
    "configuration": {
      "title": "PHX",
      "properties": {
        "phx.path": {
          "type": "string",
          "default": "phx",
          "scope": "machine",
          "description": "The phx executable used for the language server. A user setting only: a workspace cannot change which program runs."
        },
        "phx.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start `phx lsp` for diagnostics and hover types."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/grammar.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
