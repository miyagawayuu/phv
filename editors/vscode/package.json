{
  "name": "phv-language",
  "displayName": "PHV Language",
  "description": "PHV language support: syntax highlighting for .phv and .phv.html; diagnostics, completion, navigation, rename and quick fixes from `phv lsp`; and debugging with `phv dap`.",
  "version": "0.9.2",
  "publisher": "phv-lang",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://phv-lang.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/miyagawayuu/phv"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:phv"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "phv",
        "aliases": [
          "PHV",
          "phv"
        ],
        "extensions": [
          ".phv"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/phv-file.svg",
          "dark": "./images/phv-file.svg"
        }
      },
      {
        "id": "phv-template",
        "aliases": [
          "PHV Template"
        ],
        "filenamePatterns": [
          "*.phv.html"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/phv-file.svg",
          "dark": "./images/phv-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "phv",
        "scopeName": "source.phv",
        "path": "./syntaxes/phv.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.phv": "html",
          "source.sql": "sql",
          "source.js": "javascript",
          "source.css": "css"
        }
      },
      {
        "language": "phv-template",
        "scopeName": "text.html.phv",
        "path": "./syntaxes/phv-html.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.phv": "phv",
          "source.sql": "sql",
          "source.js": "javascript",
          "source.css": "css"
        }
      }
    ],
    "breakpoints": [
      {
        "language": "phv"
      }
    ],
    "debuggers": [
      {
        "type": "phv",
        "label": "PHV",
        "languages": [
          "phv"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The script to run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the script (read with argv()).",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first statement.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "phv",
            "request": "launch",
            "name": "Run the current PHV script",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "PHV: run a script",
            "description": "Run a .phv script under the debugger",
            "body": {
              "type": "phv",
              "request": "launch",
              "name": "Run ${1:script}",
              "program": "^\"\\${workspaceFolder}/${1:main.phv}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "PHV",
      "properties": {
        "phv.path": {
          "type": "string",
          "default": "phv",
          "scope": "machine",
          "description": "The phv executable used for the language server and the debugger. A user setting only: a workspace cannot change which program runs."
        },
        "phv.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start `phv lsp` for diagnostics, hover types, completion and go to definition."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/grammar.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
